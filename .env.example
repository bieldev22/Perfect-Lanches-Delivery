# Local: demonstração, banco e credenciais não são enviados ao navegador.
PORT=4174
HOST=127.0.0.1
PUBLIC_URL=http://127.0.0.1:4174
DELIVERY_DEMO=true
DELIVERY_DATA_DIR=.delivery

# Em produção, configure DELIVERY_DEMO=false, HTTPS e senha exclusiva (12+ caracteres).
ADMIN_EMAIL=admin@perfectlanches.com.br
ADMIN_PASSWORD=

# demo | mercadopago | manual. Produção recusa o modo demo.
PIX_PROVIDER=demo
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Somente no modo manual; a confirmação depende da conferência do administrador.
PIX_KEY=
PIX_MERCHANT_NAME=PERFECT LANCHES
PIX_MERCHANT_CITY=FORTALEZA

# Sem chave, análises estatísticas locais continuam disponíveis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
